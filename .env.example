# ---------------------------------------------------------------------------
# Copy to .env and fill in ONE provider. .env is gitignored -- never commit it.
# ---------------------------------------------------------------------------

# Which provider profile to use. See PROFILES in aip/config.py.
#   gemini          -> generous free tier. The default, and fully verified.
#   nvidia          -> NVIDIA NIM developer key. Also fully verified, and the
#                      recommended fallback if the Gemini tier gives you trouble.
#   groq            -> free tier, not verified end to end
#   ollama          -> fully local, zero cost, no network, no key
#   anthropic | openai -> paid
AIP_PROFILE=gemini

# --- keys: fill in exactly the one matching AIP_PROFILE --------------------
GEMINI_API_KEY=
# NVIDIA_API_KEY=          # from build.nvidia.com -- starts with nvapi-
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# (ollama needs no key -- run `ollama serve` and `ollama pull llama3.1:8b`)

# --- cost safety -----------------------------------------------------------
# Hard ceiling for one process. Trips BudgetExceeded and stops the run.
# Raise it deliberately, never reflexively.
AIP_BUDGET_USD=2.0

# --- caching ---------------------------------------------------------------
AIP_CACHE=1          # 1 = identical requests are free and instant
AIP_OFFLINE=0        # 1 = replay cache only; a cache miss raises instead of spending

# --- generation ------------------------------------------------------------
AIP_TEMPERATURE=0.0  # deterministic by default. Raise it deliberately, per call.
AIP_TIMEOUT_S=60
